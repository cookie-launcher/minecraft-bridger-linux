<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-android</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <ApplicationId>com.jstudio.bridger</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <AndroidPackageFormats>apk</AndroidPackageFormats>
    <!-- Spike: hızlı derleme için AOT kapalı -->
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <!-- Core, yansımalı System.Text.Json kullanıyor; trim kapatık (en azından şimdilik). -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <!-- Not: Avalonia.Android 12.x yalnızca net10.0-android hedefliyor;
         .NET 9 bandında 11.3.x kullanılır (masaüstü 12.1.4'ten bağımsız —
         Core hiçbir Avalonia paketine bağlı değil). -->
    <PackageReference Include="Avalonia.Android" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <!-- Gömülü JRE'nin tar.xz paketlerini açmak için (xz akışı) -->
    <PackageReference Include="SharpCompress" Version="0.50.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bridger.Core\Bridger.Core.csproj" />
  </ItemGroup>

</Project>
